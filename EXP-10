
#include <iostream>
using namespace std;

int main()
{
    int marks;

    cout << "Enter exam marks: ";
    cin >> marks;

    try
    {
        if (marks < 0 || marks > 100)
        {
            throw marks;
        }

        cout << "Valid marks: " << marks << endl;
    }
    catch (int m)
    {
        cout << "Exception caught!" << endl;
        cout << "Invalid marks: " << m << endl;
        cout << "Marks must be between 0 and 100." << endl;
    }

    return 0;
}
